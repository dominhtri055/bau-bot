# Required
OPENAI_API_KEY=sk-your-key-here

# Strong general coding/reasoning model. Change this without touching code.
BAU_MODEL=gpt-5.6-sol
BAU_REASONING_EFFORT=medium

# Voice
BAU_TRANSCRIBE_MODEL=gpt-transcribe
BAU_TTS_MODEL=gpt-4o-mini-tts
BAU_TTS_VOICE=coral

# Optional default Coding workspace. You can also pick a project from the UI.
# Example on Windows:
# BAU_WORKSPACE_ROOT=C:\\Users\\YourName\\source\\repos
BAU_WORKSPACE_ROOT=
